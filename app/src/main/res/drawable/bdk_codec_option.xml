<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00D4FF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/bdk_accent_primary" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00D4FF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/bdk_accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bdk_background_elevated" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/bdk_border" />
        </shape>
    </item>
</selector>
